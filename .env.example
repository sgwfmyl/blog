# ===== 环境变量模板 =====
# 复制此文件为 .env 并填入真实值

# 高德地图 Key
# 申请地址: https://console.amap.com/dev/key/app
PUBLIC_AMAP_KEY=
PUBLIC_AMAP_KEY_PLACES=

# Umami 统计
PUBLIC_UMAMI_BASE=
PUBLIC_UMAMI_USERNAME=
PUBLIC_UMAMI_PASSWORD=
PUBLIC_UMAMI_WEBSITE_ID=
PUBLIC_UMAMI_SHARE_ID=

# Waline 评论
PUBLIC_WALINE_SERVER=

# CloudFlare ImgBed 图床（用于说说/足迹图片上传）
# 部署地址，不带末尾斜杠
PUBLIC_IMAGEBED_URL=
# 上传认证码
PUBLIC_IMAGEBED_AUTH_CODE=
# 留言图片上传渠道（telegram/cfr2/s3/discord/huggingface/...），留空则用图床默认渠道
PUBLIC_IMAGEBED_CHANNEL=
# 渠道名称（多渠道场景，如 "blog"），通过 /api/channels 可查，留空则不传
PUBLIC_IMAGEBED_CHANNEL_NAME=
# 留言图片上传目录（相对路径，如 "blog/comment"），留空则上传到根目录
PUBLIC_IMAGEBED_UPLOAD_FOLDER=
# API Token（需要 list 权限，用于上传前查重，避免重复上传相同图片）
PUBLIC_IMAGEBED_API_TOKEN=

# 文章朗读 TTS 服务地址（EdgeOne Pages 环境变量 + 本地 .env；留空则用系统语音）
PUBLIC_TTS_SERVER=

# 自建 new-api 中转站（scripts/生成摘要 用，OpenAI 兼容端点；AI_MODEL 须与渠道「模型」一致）
# AI_RELAY_TOKEN 在 new-api 后台「令牌」页创建；免费模型示例 @cf/qwen/qwen3-30b-a3b-fp8（非推理、便宜）
AI_RELAY_URL=
# 分发令牌（new-api 后台创建）
AI_RELAY_TOKEN=
# 完整模型 ID（与渠道「模型」逐字一致）
AI_MODEL=@cf/qwen/qwen3-30b-a3b-fp8
CLOUDFLARE_API_TOKEN=你的token
CLOUDFLARE_ACCOUNT_ID=你的account_id