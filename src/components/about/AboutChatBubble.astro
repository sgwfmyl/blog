---
import { profileConfig } from "@/config";

const avatarValue = profileConfig.avatar || "";
---

<div class="about-chat-bubble">
	<span class="about-chat-bubble__avatar" aria-hidden="true">
		{avatarValue ? (
			<img
				class="about-chat-bubble__avatar-image"
				src={avatarValue}
				alt=""
				loading="lazy"
				decoding="async"
			/>
		) : (
			<span class="about-chat-bubble__avatar-fallback">lh</span>
		)}
	</span>
	<div class="about-chat-bubble__content">
		<span class="about-chat-bubble__name">lh</span>
		<div class="about-chat-bubble__text"><slot /></div>
	</div>
</div>
