---
import { getCollection } from "astro:content";
import { Icon } from "astro-icon/components";
import WidgetLayout from "@/components/common/WidgetLayout.astro";
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";
import { processCoverImageSync } from "@/utils/image-utils";
import { getPostUrlBySlug } from "@/utils/url-utils";
import RecentItemsList from "./RecentItemsList.svelte";

const posts = await getCollection("posts", ({ data }) => {
	return import.meta.env.PROD ? data.draft !== true : true;
});
const moments = await getCollection("moments");
const bangumi = await getCollection("bangumi");
const notebooksEntries = await getCollection("notebooks");
const notebookNames: Record<string, string> = {};
for (const n of notebooksEntries) {
	if (n.id.includes("_index")) {
		const folder = n.id
			.replace(/\\/g, "/")
			.replace(/\/_index(\.md|\.json)?$/, "");
		notebookNames[folder] = n.data.name || folder;
	}
}

const allItems = [
	...posts
		.sort((a, b) => b.data.published.getTime() - a.data.published.getTime())
		.slice(0, 2)
		.map((p) => ({
			type: "post",
			title: p.data.title,
			date: p.data.published,
			url: getPostUrlBySlug(p.id),
			image: processCoverImageSync(p.data.image || "api", p.id),
			id: p.id,
		})),
	...moments
		.sort((a, b) => b.data.published.getTime() - a.data.published.getTime())
		.slice(0, 2)
		.map((m) => {
			let title = m.body || "";
			title = title.replace(/[#*`]/g, "").trim();
			if (title.length > 40) title = `${title.substring(0, 40)}...`;
			if (!title) title = i18n(I18nKey.moments) || "日常动态";
			let image = "";
			if (Array.isArray(m.data.images) && m.data.images.length > 0) {
				image =
					typeof m.data.images[0] === "string"
						? m.data.images[0]
						: m.data.images[0].src;
			} else if (typeof m.data.images === "string") {
				image = m.data.images;
			}
			return {
				type: "moment",
				title,
				date: m.data.published,
				url: `/moments/#${m.id}`,
				image,
				id: m.id,
			};
		}),
	...bangumi
		.sort(
			(a, b) =>
				(b.data.published || new Date(0)).getTime() -
				(a.data.published || new Date(0)).getTime(),
		)
		.slice(0, 2)
		.map((b) => {
			let url = b.data.link || "";
			if (!url) {
				const slug = b.id
					.replace(/\\/g, "/")
					.replace(/\.(md|mdx|markdown)$/i, "");
				url =
					b.data.category === "book"
					? `/books/${slug}/`
					: "/movies-games/";
			}
			return {
				type: "bangumi",
				title: b.data.title,
				date: b.data.published || new Date(0),
				url,
				image:
					typeof b.data.image === "string" ? b.data.image : b.data.image.src,
				id: b.id,
			};
		}),
	...notebooksEntries
		.filter((n) => !n.id.includes("_index"))
		.sort(
			(a, b) =>
				(b.data.date ? new Date(b.data.date).getTime() : 0) -
				(a.data.date ? new Date(a.data.date).getTime() : 0),
		)
		.slice(0, 2)
		.map((n) => {
			const folder = n.id.replace(/\\/g, "/").split("/")[0];
			const slug = (n.id.split("/").pop() || "").replace(/\.md$/, "");
			return {
				type: "life-notebook",
				title: `${notebookNames[folder] || folder} · ${n.data.name || "未命名"}`,
				date: n.data.date || new Date(),
				url: `/life/notebooks/${folder}/#note-${slug}`,
				image:
					n.data.cover ||
					"https://img.tsh520.cn/file/blog/album/武侠风/22.webp",
				id: n.id,
			};
		}),
];

const recentItems = allItems
	.sort((a, b) => b.date.getTime() - a.date.getTime())
	.slice(0, 10);
const defaultImage = "https://img.tsh520.cn/file/blog/album/武侠风/22.webp";

interface Props {
	class?: string;
	style?: string;
}
const className = Astro.props.class;
const style = Astro.props.style;
---

<WidgetLayout name={i18n(I18nKey.recentItems)} id="recent-items" class={className} style={style}>
  <Icon name="material-symbols:history" slot="title-icon" class="text-xl" />
  <!-- 列表由 RecentItemsList 客户端渲染：构建期公开数据 + 登录后合并私密条目 -->
  <RecentItemsList items={recentItems} client:load />
</WidgetLayout>


