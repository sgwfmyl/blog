---
import { getCollection } from "astro:content";
import { Icon } from "astro-icon/components";
import WidgetLayout from "@/components/common/WidgetLayout.astro";
import { siteConfig } from "@/config";
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";
import {
	getCategoryList,
	getSortedPosts,
	getTagList,
} from "@/utils/content-utils";

interface Props {
	class?: string;
	style?: string;
}

const { class: className, style } = Astro.props;

// 从配置中获取站点开始日期
const siteStartDate = siteConfig.siteStartDate || "2025-01-01";

// 获取所有内容
const posts = await getSortedPosts();
const categories = await getCategoryList();
const tags = await getTagList();
const moments = await getCollection("moments");
const bangumi = await getCollection("bangumi");
const notebooks = await getCollection("notebooks");
const bills = await getCollection("bills");

// 统计生活记录子分类
const animeCount = bangumi.filter(
	(item) => item.data.category === "anime",
).length;
const bookCount = bangumi.filter(
	(item) => item.data.category === "book",
).length;
const gameCount = bangumi.filter(
	(item) => item.data.category === "game",
).length;

// 统计生活数据
const lifeEntries = await getCollection("life");
// 足迹记录（life 集合的 glob 覆盖了 life/notebooks/ 目录，笔记本条目归 notebooks 集合统计，此处排除避免重复）
const isIn = (entryId: string, folder: string) =>
	entryId.replace(/\\/g, "/").startsWith(`${folder}/`);
const placesCount = lifeEntries.filter((entry) =>
	isIn(entry.id, "places"),
).length;

// 记录次数 = 影视 + 书籍 + 游戏 + 足迹
// （笔记本相关数量按加密口径不计入，与 LifeStats 一致）
const recordCount = animeCount + bookCount + gameCount + placesCount;

// 计算总字数（中文字符 + 英文字母，去掉代码块/内联代码/空白）
function countWords(text: string | undefined): number {
	if (!text) return 0;
	const clean = text
		.replace(/```[\s\S]*?```/g, "")
		.replace(/`[^`]*`/g, "")
		.replace(/\s+/g, " ")
		.trim();
	const chineseChars = clean.match(/[\u4e00-\u9fa5]/g) || [];
	const englishChars = clean.match(/[a-zA-Z]/g) || [];
	return chineseChars.length + englishChars.length;
}

let totalWords = 0;
for (const post of posts) {
	totalWords += countWords(post.body);
}
// 动态正文字数
for (const moment of moments) {
	totalWords += countWords(moment.body);
}
// 笔记本正文字数（排除 _index 元数据条目）
for (const note of notebooks) {
	if (/\/(_index|_index\.md|_index\.json)$/.test(note.id.replace(/\\/g, "/")))
		continue;
	totalWords += countWords(note.body);
}
// 足迹等 life 记录字数（排除 notebooks/ 前缀，避免与 notebooks 集合重复计数）
for (const lifeEntry of lifeEntries) {
	if (lifeEntry.id.replace(/\\/g, "/").startsWith("notebooks/")) continue;
	totalWords += countWords(lifeEntry.body);
}

// 格式化数字（添加千位分隔符）
function formatNumber(num: number): string {
	return num.toLocaleString();
}

// 最近活动日期：取全部内容集合（文章/动态/书影音/足迹/笔记/账单）的最大日期，日程（未来事项）不计
const latestActivity = [
	...posts.map((p) => p.data.published),
	...moments.map((m) => m.data.published),
	...bangumi.map((b) => b.data.published),
	...lifeEntries.map((l) => l.data.date),
	...notebooks.map((n) => n.data.date),
	...bills.map((b) => b.data.date),
]
	.filter((d): d is Date => d instanceof Date)
	.reduce<Date | null>(
		(latest, d) => (latest === null || d > latest ? d : latest),
		null,
	);

const latestActivityDate = latestActivity ? latestActivity.toISOString() : null;

const todayText = i18n(I18nKey.today);

const stats = [
	{
		icon: "material-symbols:article-outline",
		label: i18n(I18nKey.siteStatsPostCount),
		value: posts.length,
		id: "post-count",
	},
	{
		icon: "material-symbols:local-cafe-outline",
		label: i18n(I18nKey.moments),
		value: moments.length,
		id: "moment-count",
	},
	{
		icon: "material-symbols:edit-note-outline",
		label: "记录次数",
		value: recordCount,
		id: "record-count",
	},
	{
		icon: "material-symbols:folder-outline",
		label: i18n(I18nKey.siteStatsCategoryCount),
		value: categories.length,
		id: "category-count",
	},
	{
		icon: "material-symbols:label-outline",
		label: i18n(I18nKey.siteStatsTagCount),
		value: tags.length,
		id: "tag-count",
	},
	{
		icon: "material-symbols:text-ad-outline-rounded",
		label: i18n(I18nKey.siteStatsTotalWords),
		value: totalWords,
		formatted: true,
		id: "total-words",
	},
	{
		icon: "material-symbols:calendar-clock-outline",
		label: i18n(I18nKey.siteStatsRunningDays),
		value: 0, // 将由客户端更新
		suffix: i18n(I18nKey.siteStatsDays).replace("{days}", ""),
		dynamic: true,
		id: "running-days",
	},
	{
		icon: "material-symbols:ecg-heart-outline",
		label: i18n(I18nKey.siteStatsLastUpdate),
		value: 0, // 将由客户端更新
		suffix: i18n(I18nKey.siteStatsDaysAgo).replace("{days}", ""),
		dynamic: true,
		id: "last-update",
	},
];

// 私密合并基准：公开分类/标签名集合（供脚本计算私密独有增量）
const publicCategoryNames = categories.map((c) => c.name);
const publicTagNames = tags.map((t) => t.name);
---

<WidgetLayout name={i18n(I18nKey.siteStats)} id="site-stats" class={className} style={style}>
  <div class="flex flex-col gap-2">
    {stats.map((stat) => (
      <div class="flex items-center justify-between px-3 py-1.5">
        <div class="flex items-center gap-2.5">
          <div class="text-xl {stat.iconColor === 'red' ? 'text-red-500 dark:text-red-400' : 'text-(--primary)'}">
            <Icon name={stat.icon} />
          </div>
          <span class="text-neutral-700 dark:text-neutral-300 font-medium text-sm">
            {stat.label}
          </span>
        </div>
        <div class="flex items-center">
          <span 
            class="text-base font-bold text-neutral-900 dark:text-neutral-100"
            data-stat-id={stat.id}
          >
            {stat.formatted ? formatNumber(stat.value) : stat.value}
          </span>
          {stat.suffix && (
            <span class="text-sm text-neutral-500 dark:text-neutral-400 ml-1">
              {stat.suffix}
            </span>
          )}
        </div>
      </div>
    ))}
  </div>
</WidgetLayout>

<script is:inline define:vars={{ siteStartDate, latestActivityDate, todayText, publicCategoryNames, publicTagNames, publicPosts: posts.length, publicMoments: moments.length, publicRecord: recordCount, publicCategories: categories.length, publicTags: tags.length }}>
  function setStatValue(id, value) {
    document.querySelectorAll('[data-stat-id="' + id + '"]').forEach(function (element) {
      element.textContent = Number(value).toLocaleString();
    });
  }

  /** 合并私密条目增量：文章/动态/记录/分类/标签/最近活动日期 */
  function mergePrivateStats() {
    var store = window.__fireflyPrivateMetaStore;
    if (!store) return;
    var stats = store.getStats();
    if (!stats || !stats.posts.length && !stats.moments.length && !stats.bangumi.length && !stats.life.length) return;

    setStatValue("post-count", publicPosts + stats.posts.length);
    setStatValue("moment-count", publicMoments + stats.moments.length);
    setStatValue("record-count", publicRecord + stats.bangumi.length + stats.life.length);

    // 分类/标签只叠加私密独有部分（与公开去重）
    var pubCats = new Set(publicCategoryNames);
    var extraCats = stats.categories.filter(function (c) { return !pubCats.has(c); }).length;
    setStatValue("category-count", publicCategories + extraCats);

    var pubTags = new Set(publicTagNames);
    var extraTags = stats.tags.filter(function (t) { return !pubTags.has(t); }).length;
    setStatValue("tag-count", publicTags + extraTags);

    // 最近活动日期：私密日期更新则重算 last-update（latestActivityDate 已含公开集合）
    if (stats.latestDate) {
      var mergedLatest = latestActivityDate
        ? new Date(Math.max(new Date(latestActivityDate).getTime(), new Date(stats.latestDate).getTime()))
        : new Date(stats.latestDate);
      updateLastUpdate(mergedLatest);
    }
  }

  function updateLastUpdate(latestActivity) {
    var today = new Date();
    var timeSinceLastActivity = Math.abs(today.getTime() - latestActivity.getTime());
    var daysSinceLastUpdate = Math.floor(timeSinceLastActivity / (1000 * 60 * 60 * 24));

    document.querySelectorAll('[data-stat-id="last-update"]').forEach(function (element) {
      if (daysSinceLastUpdate === 0) {
        element.textContent = todayText;
        if (element.nextElementSibling) {
          element.nextElementSibling.style.display = 'none';
        }
      } else {
        element.textContent = daysSinceLastUpdate.toString();
        if (element.nextElementSibling) {
          element.nextElementSibling.style.display = '';
        }
      }
    });
  }

  function updateDynamicStats() {
    const today = new Date();

    // 更新运行天数
    const startDate = new Date(siteStartDate);
    const diffTime = Math.abs(today.getTime() - startDate.getTime());
    const diffDays = Math.ceil(diffTime / (1000 * 60 * 60 * 24));

    const runningDaysElements = document.querySelectorAll('[data-stat-id="running-days"]');
    runningDaysElements.forEach((element) => {
      element.textContent = diffDays.toString();
    });

    // 更新最后活动时间（全部内容集合的最新日期；私密合并会在登录后覆盖为更大的日期）
    if (latestActivityDate) {
      const lastActivity = new Date(latestActivityDate);
      updateLastUpdate(lastActivity);
    }

    // 登录态下把私密条目统计进去（门面尚未就绪时由 ready 事件再触发）
    mergePrivateStats();
  }

  function bootPrivateMerge() {
    var store = window.__fireflyPrivateMetaStore;
    if (!store) return;
    // 已拉取过元数据则立即合并一次；之后由 store 的订阅持续同步
    store.subscribePrivateMeta(function () {
      mergePrivateStats();
    });
    mergePrivateStats();
  }

  // 页面加载时更新
  updateDynamicStats();

  // 页面切换时重新更新
  document.addEventListener("swup:content:replaced", () => {
    setTimeout(updateDynamicStats, 100);
  });

  if (window.__fireflyPrivateMetaStore) {
    bootPrivateMerge();
  } else {
    window.addEventListener("firefly:private-meta-store-ready", bootPrivateMerge, { once: true });
  }
</script>
