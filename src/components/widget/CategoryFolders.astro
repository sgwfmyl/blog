---
import type { CategoryNode } from "@/utils/category-tree";
import CategoryFoldersTree from "./CategoryFoldersTree.svelte";

interface Props {
	tree: CategoryNode[];
}

const { tree } = Astro.props;
---

<!-- 文件夹分类树由 CategoryFoldersTree 客户端渲染：公开分类树 + 登录后合并私密分类树 -->
<CategoryFoldersTree tree={tree} client:load />
