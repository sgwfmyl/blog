---
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";
import type { TagGraphData } from "@/utils/tag-graph-data";

interface Props {
	graph: TagGraphData;
}

const { graph } = Astro.props;
const accessibleLabel = i18n(I18nKey.tagGraphAccessible)
	.replace("{tags}", String(graph.nodes.length))
	.replace("{links}", String(graph.links.length));
const initialStatus =
	graph.nodes.length === 0
		? i18n(I18nKey.tagGraphEmpty)
		: i18n(I18nKey.tagGraphPreparing);
---

<div
	id="tag-graph-container"
	class="tag-graph"
	data-graph={JSON.stringify(graph)}
>
  <h2 class="category-section-title">
    <span class="category-section-title__bar" aria-hidden="true"></span>
    {i18n(I18nKey.tagGraphSectionTitle)}
  </h2>

  <div
    id="tag-graph-chart"
    class="tag-graph__chart"
    data-tag-graph-surface
    data-state={graph.nodes.length === 0 ? "empty" : "idle"}
  >
    <canvas
      class="tag-graph__canvas"
      data-tag-graph-canvas
      role="img"
      tabindex="0"
      aria-label={accessibleLabel}
    >
      {accessibleLabel}
    </canvas>
    <div
      class="tag-graph__status"
      data-tag-graph-status
      aria-live="polite"
    >
      {initialStatus}
    </div>
    <div
      class="tag-graph__tooltip"
      data-tag-graph-tooltip
      role="tooltip"
      aria-hidden="true"
      hidden
    >
      <strong data-tag-graph-tooltip-title></strong>
      <span data-tag-graph-tooltip-meta></span>
    </div>
  </div>
</div>

<script>
  import type { TagGraphController } from "@/utils/tag-graph-controller";
  import I18nKey from "@/i18n/i18nKey";
  import { i18n } from "@/i18n/translation";

  let activeController: TagGraphController | null = null;
  let loadingObserver: IntersectionObserver | null = null;
  let loadVersion = 0;

  function cleanupTagGraphLoader() {
    loadVersion++;
    loadingObserver?.disconnect();
    loadingObserver = null;
    activeController?.destroy();
    activeController = null;
  }

  async function loadTagGraph(root: HTMLElement, version: number) {
    const surface = root.querySelector<HTMLElement>("[data-tag-graph-surface]");
    if (!surface || surface.dataset.state === "empty") return;

    surface.dataset.state = "loading";
    try {
      const { mountTagGraph } = await import("@/utils/tag-graph-controller");
      if (version !== loadVersion || !root.isConnected) return;
      activeController = mountTagGraph(root);
    } catch (error) {
      if (version !== loadVersion || !root.isConnected) return;
      surface.dataset.state = "error";
      const status = surface.querySelector<HTMLElement>("[data-tag-graph-status]");
      if (status) status.textContent = i18n(I18nKey.tagGraphFailed);
      console.error("Failed to load the tag graph", error);
    }
  }

  function initTagGraphLoader() {
    cleanupTagGraphLoader();

    const root = document.getElementById("tag-graph-container");
    if (!root) return;
    const surface = root.querySelector<HTMLElement>("[data-tag-graph-surface]");
    if (!surface || surface.dataset.state === "empty") return;

    const version = loadVersion;
    loadingObserver = new IntersectionObserver((entries) => {
      const entry = entries[0];
      if (!entry?.isIntersecting || surface.offsetWidth === 0 || surface.offsetHeight === 0) return;
      loadingObserver?.disconnect();
      loadingObserver = null;
      void loadTagGraph(root, version);
    }, { rootMargin: "120px 0px" });
    loadingObserver.observe(surface);
  }

  initTagGraphLoader();
  document.addEventListener("astro:page-load", initTagGraphLoader);

  declare global {
    interface Window {
      __fireflyRerenderTagGraph?: () => void;
    }
  }
  // 私密标签合并脚本更新 data-graph 后调用此入口销毁并重建图谱
  window.__fireflyRerenderTagGraph = initTagGraphLoader;
</script>

<script is:inline>
(function () {
  var baselineGraph = null;

  function getBaseline() {
    if (baselineGraph) return baselineGraph;
    var container = document.getElementById("tag-graph-container");
    if (!container) return null;
    var raw = container.getAttribute("data-graph");
    if (!raw) return null;
    try {
      baselineGraph = JSON.parse(raw);
    } catch (e) {
      baselineGraph = null;
    }
    return baselineGraph;
  }

  /** 私密文章的标签节点/共现对统计（与 tag-graph-data.ts 口径一致） */
  function privateTagStats() {
    var store = window.__fireflyPrivateMetaStore;
    if (!store) return null;
    var posts = store.getStats().posts;
    if (!posts || !posts.length) return null;
    var nodeMap = {};
    var pairMap = {};
    posts.forEach(function (p) {
      var seen = {};
      var tags = [];
      (p.tags || []).forEach(function (t) {
        var name = String(t).trim();
        if (name && !seen[name]) {
          seen[name] = true;
          tags.push(name);
        }
      });
      tags.sort();
      if (!tags.length) return;
      tags.forEach(function (tag) {
        nodeMap[tag] = (nodeMap[tag] || 0) + 1;
      });
      for (var i = 0; i < tags.length; i++) {
        for (var j = i + 1; j < tags.length; j++) {
          var key = tags[i] + "\u0000" + tags[j];
          pairMap[key] = (pairMap[key] || 0) + 1;
        }
      }
    });
    return { nodeMap: nodeMap, pairMap: pairMap };
  }

  function buildMergedGraph(baseline, priv) {
    var nodeMap = {};
    baseline.nodes.forEach(function (n) {
      nodeMap[n.name] = { id: n.id, name: n.name, value: n.value, url: n.url };
    });
    Object.keys(priv.nodeMap).forEach(function (name) {
      if (nodeMap[name]) {
        nodeMap[name].value += priv.nodeMap[name];
      } else {
        nodeMap[name] = { id: name, name: name, value: priv.nodeMap[name], url: "" };
      }
    });

    var linkMap = {};
    baseline.links.forEach(function (l) {
      linkMap[l.source + "\u0000" + l.target] = { source: l.source, target: l.target, value: l.value };
    });
    Object.keys(priv.pairMap).forEach(function (key) {
      var parts = key.split("\u0000");
      var k = parts[0] + "\u0000" + parts[1];
      if (linkMap[k]) {
        linkMap[k].value += priv.pairMap[key];
      } else if (priv.pairMap[key] >= baseline.threshold) {
        linkMap[k] = { source: parts[0], target: parts[1], value: priv.pairMap[key] };
      }
    });

    return {
      nodes: Object.keys(nodeMap).map(function (k) { return nodeMap[k]; }),
      links: Object.keys(linkMap).map(function (k) { return linkMap[k]; }),
      threshold: baseline.threshold,
    };
  }

  function applyMerge() {
    var container = document.getElementById("tag-graph-container");
    var baseline = getBaseline();
    if (!container || !baseline) return;
    var priv = window.__fireflyPrivateMetaStore ? privateTagStats() : null;
    var graphData = priv ? buildMergedGraph(baseline, priv) : baseline;
    container.setAttribute("data-graph", JSON.stringify(graphData));
    if (window.__fireflyRerenderTagGraph) window.__fireflyRerenderTagGraph();
  }

  function boot() {
    var store = window.__fireflyPrivateMetaStore;
    if (!store) return;
    store.subscribePrivateMeta(applyMerge);
    applyMerge();
  }

  // 订阅只注册一次；每次进入本页（脚本随 SPA 导航重新执行）都重新应用
  if (!window.__privateTagGraphBound) {
    window.__privateTagGraphBound = true;
    if (window.__fireflyPrivateMetaStore) {
      boot();
    } else {
      window.addEventListener("firefly:private-meta-store-ready", boot, { once: true });
    }
  }
  applyMerge();
})();
</script>
