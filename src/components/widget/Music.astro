---
import WidgetLayout from "@/components/common/WidgetLayout.astro";
import MusicPlayer from "@/components/features/MusicPlayer.astro";
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";
import { getMergedMusicPlaylist } from "@/utils/music-playlist";

interface Props {
	class?: string;
	style?: string;
}
const { class: className, style } = Astro.props;

const widgetId = `music-widget-${Math.random().toString(36).substring(2, 9)}`;

// 音乐歌单数据源：music content collection（JSON），url 播放时由 MusicManager 懒解析
const musicTracks = (await getMergedMusicPlaylist()).map((song) => ({
	name: song.name,
	artist: song.artist,
	pic: "",
	url: "",
	lrc: "",
	metingServer: song.server,
	metingId: song.metingId,
}));

const playlistJson = JSON.stringify(musicTracks);
---

<WidgetLayout id={`${widgetId}-layout`} class={className} style={style} name={i18n(I18nKey.music)}>
    <MusicPlayer id={widgetId} externalPlaylist={playlistJson} />
</WidgetLayout>
