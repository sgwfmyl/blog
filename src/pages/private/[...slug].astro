---
import { Icon } from "astro-icon/components";
import PageTitle from "@/components/common/PageTitle.astro";
import MainGridLayout from "@/layouts/MainGridLayout.astro";

// 私密空间只有一个静态壳（/private/）：内容全部动态加载。
// 详情路径 /private/<slug> 由 Worker 在运行时把请求回退到这个壳，
// 页面脚本再从 pathname 提取 slug 拉取（见 worker/index.ts 的 /private 回退分支）。
//
// 渲染统一（2026-10-15）：详情视图复用公开文章页骨架——post-hero（标题+Meta 行）
// + #post-container 正文卡 + .markdown-content 排版容器；MainGridLayout 传入
// postSlug 触发「文章页布局」（is-post-layout 无侧栏 + 右侧 TOC 浮层），
// 正文注入完成后派发 swup:content:replaced 让 SidebarTOC 重新扫描标题（同加密页机制）。
export const getStaticPaths = () => [{ params: { slug: undefined } }];
---

<MainGridLayout
  title="私密空间"
  description="管理员私密空间"
  postSlug="private"
>

  <!-- Worker 将私密镜像 URL 也回退到本壳，故必须由服务端直接输出防收录标记。 -->
  <meta slot="head" name="robots" content="noindex, nofollow" />

  <!-- 页面交互脚本必须放在 Swup 容器内（MainGridLayout slot 里），
       Swup 换页进入时才会执行（CLAUDE.md §15） -->
  <script is:inline>
    (function () {
      /* 一次性绑定 document 级监听（head 脚本在 Swup 换页时可能被重新插入） */
      if (window.__privatePageBound) return;
      window.__privatePageBound = true;

      function currentSlug() {
        // slug 支持子目录路径（如 /private/私密/观影记录/），至少一个字符才算详情页
        // pathname 为编码形式，先 decode 一次，后续 loadDetail 的 encodeURIComponent 恰好还原为 URL 编码
        var m = window.location.pathname.match(/^\/private\/(.+)\/?$/);
        if (!m) return "";
        try {
          return decodeURIComponent(m[1]);
        } catch (e) {
          return m[1];
        }
      }

      /**
       * 私密镜像页保留原始公开路径，例如 /posts/私密日记/。
       * Worker 已在服务端根据 private/routes.json 确认该路径存在并返回本壳；
       * 前端仅在管理员身份确认后请求正文，游客不会请求任何私密 API。
       */
      function currentMappedPath() {
        var pathname = window.location.pathname;
        return /^\/private(?:\/|$)/.test(pathname) ? "" : pathname;
      }

      function escapeHtml(s) {
        return String(s).replace(/[&<>"']/g, function (c) {
          return {
            "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;",
          }[c];
        });
      }

      function renderList(items) {
        if (!items || !items.length) {
          return '<p class="private-empty">暂无私密内容</p>';
        }
        return (
          '<ul class="private-list">' +
          items
            .map(function (it) {
              return (
                '<li class="private-list__item">' +
                '<a class="private-list__link" href="/private/' +
                encodeURIComponent(it.slug) +
                '/">' +
                escapeHtml(it.title || it.slug) +
                "</a>" +
                (it.date
                  ? '<span class="private-list__date">' + escapeHtml(it.date) + "</span>"
                  : "") +
                "</li>"
              );
            })
            .join("") +
          "</ul>"
        );
      }

      /** 详情视图：用私密元数据填充 post-hero（标题/日期/分类/标签），标题缺省保持「私密空间」 */
      function renderDetail(item) {
        var titleEl = document.getElementById("private-title");
        var dateEl = document.getElementById("private-date");
        var dateDotEl = document.getElementById("private-date-dot");
        var categoryEl = document.getElementById("private-category");
        var tagsEl = document.getElementById("private-tags");
        var metaRowEl = document.getElementById("private-meta-row");
        if (!titleEl || !metaRowEl) return;

        var showMeta = false;

        if (item && item.title) {
          titleEl.textContent = item.title;
          document.title = item.title + " - 私密空间";
        }

        if (dateEl && item && item.date) {
          dateEl.textContent = String(item.date).slice(0, 10);
          dateEl.hidden = false;
          if (dateDotEl) dateDotEl.hidden = false;
          showMeta = true;
        }

        if (categoryEl && item && item.category) {
          categoryEl.textContent = "#" + item.category;
          categoryEl.hidden = false;
          showMeta = true;
        }

        if (tagsEl && item && item.tags && item.tags.length) {
          tagsEl.innerHTML = item.tags
            .map(function (tag, i) {
              return (
                '<span class="post-hero__meta-tag">' +
                (i > 0 ? '<span class="post-hero__meta-sep">/</span>' : "") +
                escapeHtml(tag) +
                "</span>"
              );
            })
            .join("");
          showMeta = true;
        }

        metaRowEl.hidden = !showMeta;
      }

      function loadList() {
        var contentEl = document.getElementById("private-content");
        if (!contentEl) return;
        contentEl.hidden = false;
        contentEl.innerHTML = '<p class="private-loading">加载中…</p>';

        fetch("/api/private/pages", { credentials: "same-origin" })
          .then(function (r) {
            return r.json();
          })
          .then(function (data) {
            if (!data || data.ok === false) {
              contentEl.innerHTML = '<p class="private-error">内容加载失败</p>';
              return;
            }
            contentEl.innerHTML = renderList(data.data);
          })
          .catch(function () {
            contentEl.innerHTML = '<p class="private-error">内容加载失败</p>';
          });
      }

      function loadDetail(slug) {
        var contentEl = document.getElementById("private-content");
        if (!contentEl) return;
        contentEl.hidden = false;
        contentEl.innerHTML = '<p class="private-loading">加载中…</p>';

        // 并行拉取：私密元数据（填充 hero）+ 正文 markdown
        var metaPromise = fetch("/api/private/meta", { credentials: "same-origin" })
          .then(function (r) {
            return r.json();
          })
          .catch(function () {
            return null;
          });
        var contentPromise = fetch(
          "/api/private/pages/" + encodeURIComponent(slug),
          { credentials: "same-origin" },
        )
          .then(function (r) {
            return r.json();
          })
          .catch(function () {
            return null;
          });

        Promise.all([metaPromise, contentPromise]).then(function (results) {
          var meta = results[0];
          var content = results[1];
          if (!content || content.ok === false) {
            contentEl.innerHTML = '<p class="private-error">内容加载失败</p>';
            return;
          }

          var item = null;
          if (meta && meta.ok && Array.isArray(meta.data)) {
            item = meta.data.find(function (m) {
              return m.slug === slug;
            });
          }
          renderDetail(item);

          contentEl.innerHTML = "";
          var renderer = window.__fireflyPrivateRenderer;
          if (renderer) {
            renderer
              .renderMarkdown(content.data, contentEl)
              .then(function () {
                // 正文注入完成：让 TOC 浮层重新扫描标题（同加密页解密后派发机制）
                document.dispatchEvent(new CustomEvent("swup:content:replaced"));
              })
              .catch(function () {
                contentEl.innerHTML = '<p class="private-error">内容渲染失败</p>';
              });
          } else {
            contentEl.textContent = content.data;
            document.dispatchEvent(new CustomEvent("swup:content:replaced"));
          }
        });
      }

      function loadMappedRoute(pathname) {
        var contentEl = document.getElementById("private-content");
        if (!contentEl) return;
        contentEl.hidden = false;
        contentEl.innerHTML = '<p class="private-loading">加载中…</p>';

        fetch("/api/private/route?path=" + encodeURIComponent(pathname), {
          credentials: "same-origin",
        })
          .then(function (r) {
            return r.json();
          })
          .then(function (payload) {
            if (!payload || payload.ok !== true || !payload.data) {
              contentEl.innerHTML = '<p class="private-error">内容加载失败</p>';
              return;
            }

            var route = payload.data.route || {};
            renderDetail(route);
            contentEl.innerHTML = "";
            var renderer = window.__fireflyPrivateRenderer;
            if (!renderer) {
              contentEl.textContent = payload.data.markdown || "";
              document.dispatchEvent(new CustomEvent("swup:content:replaced"));
              return;
            }
            renderer
              .renderMarkdown(payload.data.markdown || "", contentEl)
              .then(function () {
                document.dispatchEvent(new CustomEvent("swup:content:replaced"));
              })
              .catch(function () {
                contentEl.innerHTML = '<p class="private-error">内容渲染失败</p>';
              });
          })
          .catch(function () {
            contentEl.innerHTML = '<p class="private-error">内容加载失败</p>';
          });
      }

      function refresh() {
        var slug = currentSlug();
        var mappedPath = currentMappedPath();
        var isDetail = slug !== "" || mappedPath !== "";
        var contentEl = document.getElementById("private-content");
        var gateEl = document.getElementById("private-login-gate");
        var heroEl = document.getElementById("private-hero");
        var pageTitleEl = document.getElementById("private-page-title");
        if (!contentEl || !gateEl) return;

        fetch("/api/auth/me", { credentials: "same-origin" })
          .then(function (r) {
            return r.json();
          })
          .then(function (data) {
            if (data && data.admin) {
              gateEl.hidden = true;
              if (pageTitleEl) pageTitleEl.hidden = isDetail;
              if (heroEl) heroEl.hidden = !isDetail;
              if (mappedPath) {
                loadMappedRoute(mappedPath);
              } else if (isDetail) {
                loadDetail(slug);
              } else {
                loadList();
              }
            } else {
              contentEl.hidden = true;
              gateEl.hidden = false;
              if (pageTitleEl) pageTitleEl.hidden = false;
              if (heroEl) heroEl.hidden = true;
            }
          })
          .catch(function () {
            contentEl.hidden = true;
            gateEl.hidden = false;
            if (pageTitleEl) pageTitleEl.hidden = false;
            if (heroEl) heroEl.hidden = true;
          });
      }

      document.addEventListener("click", function (ev) {
        var btn = ev.target.closest("#private-login-btn");
        if (!btn) return;
        document.dispatchEvent(new CustomEvent("firefly:auth-modal-open"));
      });

      // 登录成功后自动刷新（AuthModal 登录成功时 dispatch）
      document.addEventListener("firefly:auth-logged-in", refresh);

      function reinit() {
        refresh();
      }

      if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", refresh);
      } else {
        refresh();
      }
      document.addEventListener("astro:page-load", reinit);
      document.addEventListener("astro:after-swap", reinit);
      document.addEventListener("swup:content:replaced", reinit);
    })();
  </script>

  <!-- 列表视图标题（详情视图由脚本隐藏） -->
  <div id="private-page-title" class="mb-8">
    <PageTitle
      title="私密空间"
      eyebrow="Private"
      description="仅管理员可见的动态内容"
    />
  </div>

  <!-- Layer 1: Hero — 详情视图复用公开文章页骨架，标题/日期/分类/标签由脚本运行时填充 -->
  <div
    id="private-hero"
    class="post-hero rounded-(--radius-large) mb-2 onload-animation"
    hidden
  >
    <div class="post-hero__content">
      <h1 class="post-hero__title" id="private-title">私密空间</h1>

      <div class="post-hero__meta-row" id="private-meta-row" hidden>
        <span class="post-hero__meta-item" id="private-date" hidden></span>
        <span class="post-hero__meta-dot" id="private-date-dot" hidden>·</span>
        <a
          href="/private/"
          class="post-hero__meta-link"
          id="private-category"
          hidden
        ></a>
        <span id="private-tags"></span>
      </div>
    </div>
  </div>

  <!-- 正文卡片：详情视图渲染 markdown，列表视图渲染条目列表（复用公开文章正文卡结构，
       保证 TOC 的 #post-container .markdown-content 选择器与停靠锚点一致） -->
  <div class="flex w-full rounded-(--radius-large) overflow-hidden relative mb-4">
    <div
      id="post-container"
      class="card-base z-10 px-3 md:px-6 lg:px-10 pb-4 pt-0 relative w-full"
    >
      <div
        id="private-content"
        class="private-content markdown-content prose dark:prose-invert max-w-none! custom-md mb-6"
      ></div>
    </div>
  </div>

  <!-- 游客登录门 -->
  <div id="private-login-gate" class="private-gate" hidden>
    <Icon name="material-symbols:lock-outline-rounded" is:inline class="private-gate__icon" />
    <p class="private-gate__text">私密空间需要管理员身份</p>
    <button type="button" id="private-login-btn" class="private-gate__btn">
      打开登录
    </button>
  </div>

</MainGridLayout>

<style>
  /* ============================================
   * 私密空间：加载 / 错误 / 列表 / 登录门
   * 正文 markdown 排版由 .prose/.custom-md（公开文章同款）承担，
   * 这里只保留容器切换与列表、登录门的专属样式。
   * ============================================ */

  .private-content[hidden],
  .private-gate[hidden] {
    display: none;
  }

  .private-loading,
  .private-error,
  .private-empty {
    padding: 2.5rem 1rem;
    text-align: center;
    font-size: 0.875rem;
    color: var(--content-meta);
  }

  /* 私密文章列表 */
  .private-list {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: 0;
    margin: 0;
    list-style: none;
  }

  .private-list__item {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.625rem 0.875rem;
    border: 1px solid var(--line-divider);
    border-radius: 0.75rem;
    transition: background-color 200ms ease, border-color 200ms ease;
  }

  .private-list__item:hover {
    background: var(--btn-plain-bg-hover);
    border-color: var(--btn-plain-bg-hover);
  }

  .private-list__link {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--deep-text);
    text-decoration: none;
  }

  .private-list__link:hover {
    color: var(--primary);
  }

  .private-list__date {
    margin-left: auto;
    flex: 0 0 auto;
    font-size: 0.75rem;
    color: var(--content-meta);
  }

  /* 登录门 */
  .private-gate {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
    padding: 3rem 1rem;
    border: 1px dashed var(--line-divider);
    border-radius: 1rem;
    text-align: center;
  }

  .private-gate__icon {
    font-size: 2.5rem;
    color: var(--content-meta);
  }

  .private-gate__text {
    margin: 0;
    font-size: 0.9375rem;
    color: var(--deep-text);
  }

  .private-gate__btn {
    padding: 0.625rem 1.5rem;
    border: none;
    border-radius: 0.75rem;
    background: var(--deep-text);
    color: var(--page-bg);
    font-family: inherit;
    font-size: 0.875rem;
    font-weight: 600;
    cursor: pointer;
    transition: opacity 150ms ease;
  }

  .private-gate__btn:hover {
    opacity: 0.85;
  }
</style>
