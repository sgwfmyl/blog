---
import { AUTH_COOKIE_NAME, verifySession } from "@utils/auth-session";
import { getMergedPosts } from "@utils/post-source";
import { getPrivateMeta } from "@utils/private-source";

// 临时验证页：验证 SSR 鉴权 + 私有数据源 + posts 合并链路（阶段 3 单点验证用，验证后删除）。
export const prerender = false;

const token = Astro.cookies.get(AUTH_COOKIE_NAME)?.value;
const isAdmin = await verifySession(token);

const privateMeta = isAdmin ? await getPrivateMeta() : [];
const privatePostCount = privateMeta.filter((m) => m.type === "post").length;
const mergedPosts = await getMergedPosts(privateMeta);
const publicCount = mergedPosts.length - privatePostCount;
---

<html lang="zh-CN">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>SSR 私密融合验证</title>
	</head>
	<body style="font-family: monospace; padding: 2rem;">
		<h1>阶段 3 单点验证</h1>
		<p>isAdmin: <b>{String(isAdmin)}</b></p>
		<p>私有 post 数: <b>{privatePostCount}</b></p>
		<p>公开 post 数: <b>{publicCount}</b></p>
		<p>合并总数: <b>{mergedPosts.length}</b></p>
		<pre>{mergedPosts.map((p) => `${p.data.published.toISOString().slice(0, 10)}  ${p.id}${"isPrivate" in p.data ? "  [私]" : ""}`).join("\n")}</pre>
	</body>
</html>