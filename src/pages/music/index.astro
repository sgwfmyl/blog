---
import Comment from "@components/comment/index.astro";
import MusicVisualizer from "@components/features/music-visualizer/MusicVisualizer.svelte";
import Layout from "@layouts/Layout.astro";
import { siteConfig } from "@/config";
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";
import { getMergedMusicPlaylist } from "@/utils/music-playlist";

if (!siteConfig.pages.musicPage) {
	return Astro.redirect("/404/");
}

// 音乐歌单数据源：music content collection（JSON），url 播放时由 MusicManager 懒解析
const collectionPlaylist = (await getMergedMusicPlaylist()).map((song) => ({
	name: song.name,
	artist: song.artist,
	url: "",
	pic: "",
	lrc: "",
	metingServer: song.server,
	metingId: song.metingId,
}));
---

<Layout title={i18n(I18nKey.musicPageTitle) + " - 3D可视化"} description="音乐地形可视化，沉浸式音乐体验">
	<main class="music-visualizer-swup">
		<h1 class="sr-only">{i18n(I18nKey.musicPageTitle)}</h1>
		<div class="music-visualizer-page">
			<MusicVisualizer client:only="svelte" />
		</div>
	</main>

	<script is:inline define:vars={{ collectionPlaylistJson: JSON.stringify(collectionPlaylist) }}>
	(function() {
		var collectionPlaylist = JSON.parse(collectionPlaylistJson);

		// 曲目 url 由 MusicManager 播放时懒解析（Meting API + 缓存），此处直接注入原始歌单
		function loadMusicPlaylist(mgr) {
			if (collectionPlaylist.length > 0) {
				mgr.loadExternalPlaylist(collectionPlaylist);
			}
		}

		// 只设置 fm:init 监听器，不调用 mgr.init()
		// MusicVisualizer 会调用 mgr.init()，确保 crossOrigin 在 src 之前设置
		function bindManager(mgr) {
			if (mgr.getState().initialized) {
				loadMusicPlaylist(mgr);
			} else {
				window.addEventListener('fm:init', function handler() {
					window.removeEventListener('fm:init', handler);
					loadMusicPlaylist(mgr);
				});
			}
		}

		// 等待 MusicManager 可用（内联脚本在 Svelte 组件挂载前运行）
		var mgr = window.__fireflyMusic;
		if (mgr) {
			bindManager(mgr);
		} else {
			var attempts = 0;
			var timer = setInterval(function() {
				mgr = window.__fireflyMusic;
				if (mgr || ++attempts > 50) {
					clearInterval(timer);
					if (mgr) bindManager(mgr);
				}
			}, 100);
		}
	})();
	</script>


</Layout>
