# ===== wrangler 本地运行时 Secrets 模板 =====
# 复制为 .dev.vars 并填入真实值（对应线上 Worker Secrets，见 deploy.yml 与 docs/deploy-cloudeflare-workers.md）
# 本地调试：pnpm build && pnpm wrangler dev（wrangler 自动读取 .dev.vars）

# 管理员登录密码（与线上 Worker Secret ADMIN_PASSWORD 一致）
ADMIN_PASSWORD=
# Cookie HMAC 签名密钥（随机 ≥32 字节；生成一次永久保存，丢失则全部会话失效）
AUTH_SECRET=
# GitHub 私有仓库只读 PAT（fine-grained token，仅授予内容仓库读取权限）
GH_PAT=
# 私有仓库归属，如 sgwfmyl
GH_OWNER=
# 私有仓库名，如 blog-private
GH_REPO=
